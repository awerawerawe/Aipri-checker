<script language="JavaScript">
function imageview(imagename) {
    if (imagename.length==0) {
        alert("拡大イメージ画像がありません"); return ;
    }
    window.open('/shop/image_view.html?image=' + imagename, "win", "height=350,width=450,toolbar=no,menubar=no,resizable=yes,status=no,scrollbars=yes");
}

// オプション在庫確認ウィンドウを開く
function openOptionWindow(){
    w = window.open("","option50","width=680,height=400,scrollbars=yes,resizable=yes");
    document.form1.target = "option50";
    document.form1.action = "/shop/stock_list.html";
    document.form1.submit();
    document.form1.action = "/shop/basket.html";
    document.form1.target = "";
}
function updateOptionPriceAjax(uid, callback){
    var id1 = '';
    var id2 = '';
    if(document.form1.brand_option){
        // 表形式のオプション
        if(document.form1.brand_option.length){
            var brand_option_length = document.form1.brand_option.length;
            for(var i=0; i<brand_option_length; i++){
                if(document.form1.brand_option[i].checked){
                    var tmp = String(document.form1.brand_option[i].value).split('_');
                    id1 = tmp[0];
                    id2 = tmp[1];
                    break;
                }
            }
        }else{
            if(document.form1.brand_option.checked){
                var tmp = String(document.form1.brand_option.value).split('_');
                id1 = tmp[0];
                id2 = tmp[1];
            }
        }
    }else{
        // プルダウン形式のオプション
        id1 = document.form1.spcode ? document.form1.spcode.value : '';
        if(String(id1) === '0'){
            return;
        }
        id2 = document.form1.spcode2 ? document.form1.spcode2.value : '';
        if(String(id2) === '0'){
            return;
        }
    }

    var xmlhttp = false;
    if(typeof ActiveXObject != "undefined"){
        try {
            xmlhttp = new ActiveXObject("Microsoft.XMLHTTP");
        } catch (e) {
            xmlhttp = false;
        }
    }
    if(!xmlhttp && typeof XMLHttpRequest != "undefined") {
        xmlhttp = new XMLHttpRequest();
    }
    xmlhttp.open('POST', '/shop/shopdetail_option.html', true);
    xmlhttp.onreadystatechange = function(){
        if (xmlhttp.readyState == 4 && xmlhttp.status == 200){
            var option_stock = eval('(' + xmlhttp.responseText + ')');
            callback(option_stock);
        }
    }
    xmlhttp.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
    xmlhttp.send('uid=' + uid + '&option1_id=' + id1 + '&option2_id=' + id2);
}
function send(temp,temp2) {
	if (document.form1.ordertype) {
		document.form1.ordertype.value = '';
	}

    if(document.form1.brand_option){
        // 表形式のオプション
        var id1 = 0;
        var id2 = 0;
        if(document.form1.brand_option.length){
            var brand_option_length = document.form1.brand_option.length;
            for(var i=0; i<brand_option_length; i++){
                if(document.form1.brand_option[i].checked){
                    var tmp = String(document.form1.brand_option[i].value).split('_');
                    id1 = tmp[0];
                    id2 = tmp[1];
                    break;
                }
            }
        }else{
            if(document.form1.brand_option.checked){
                var tmp = String(document.form1.brand_option.value).split('_');
                id1 = tmp[0];
                id2 = tmp[1];
            }
        }
        if(id1 == 0){
            alert('オプションを選択してください。');
            return;
        }
        document.form1.spcode.value = id1;
        document.form1.spcode2.value = id2;
    }else{
        // プルダウン形式のオプション
        if (document.form1.spcode && document.form1.spcode.selectedIndex < 2) {
            alert('オプションを選択してください。');
            document.form1.spcode.focus();
            return;
        }
        if (document.form1.spcode2 && document.form1.spcode2.selectedIndex < 2) {
            alert('オプションを選択してください。');
            document.form1.spcode2.focus();
            return;
        }
    }

    if (document.form1.amount.value.length==0)
    {
        alert("注文数量を入力して下さい"); document.form1.amount.focus();
        return;
    }

    var amountstr = document.form1.amount.value.toString();
    if ( (isNaN(document.form1.amount.value)) || (amountstr.match(/[^0-9]/)))
    {
        alert("注文数量には半角数字を入力して下さい");
        document.form1.amount.focus(); return;
    }
    if(temp=="baro") document.form1.ordertype.value='baro';
    if(temp2!=""){
        document.form1.opts.value="";
        var option_group = document.form1.mulopt;

        
        for(i=0;i<temp2;i++){
            if(document.form1.optselect[i].value==1 && option_group[i].selectedIndex==0){
                alert('必須選択項目です.オプションを必ず選んで下さい');
                option_group[i].focus();
                return;
            }
            document.form1.opts.value+=option_group[i].selectedIndex+",";
        }
    }

    
    document.form1.submit();
}

function count_change(temp)
{
    var cnt=document.form1.amount.value;
    if(temp == 0 && cnt < 999999999){
        cnt++;
    }else if(temp==1){
        if(cnt > 1) cnt--;
    }
    document.form1.amount.value=cnt;
}



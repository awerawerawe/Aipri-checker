<script>
function charcount(str) {
    var len = 0;
    var str = escape(str);
    for (i=0;i<str.length;i++,len++) {
        if (str.charAt(i) == "%") {
            if (str.charAt(++i) == "u") {
                i += 3;
                len++;
            }
            i++;
        }
    }
    return len;
}

function review_send(){
    var formReview = document.re_form;
    if(formReview.review_name.value.length==0){
        alert('ニックネームを入力して下さい');
        formReview.review_name.focus();
        return;
    } else if (charcount(formReview.review_name.value) > 20 ) {
        alert('ニックネームは全角10字以内でご入力ください');
        formReview.review_name.focus();
        return;
    }

    if(formReview.content.value.length==0){
        alert('評価内容を入力して下さい');
        formReview.content.focus();
        return;
    } else if (charcount(formReview.content.value) > 4000 ) {
        alert('評価内容は全角2000字以内でご入力ください');
        formReview.content.focus();
        return;
    }

    formReview.review.value = 'review';
    formReview.action = '/shopdetail/000000040663/hap-oa04/recommend/';
    formReview.submit();
}
</script>
